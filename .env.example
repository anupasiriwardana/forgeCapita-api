# forgeCapita API — Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (Neon or any compatible provider); required, must start with postgres:// or postgresql://
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Port the Express server listens on (1-65535, default 3001)
PORT=3001

# Runtime mode: development | test | production (default development)
NODE_ENV=development

# Comma-separated exact browser origins allowed by CORS (scheme + host [+ port], no path,
# no trailing slash, no wildcard). Default http://localhost:3000 outside production;
# REQUIRED and non-empty in production, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Number of reverse-proxy hops to trust for client IP / rate limiting (0-5, default 0).
# Use 1 behind a single proxy such as Render. Never set to "true".
TRUST_PROXY=0

# Log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# Maximum JSON request body size, e.g. 100kb (default 100kb)
BODY_LIMIT=100kb

# Rate limiting (per IP, in-memory). Window in ms (default 60000); requests per window
# for all routes (default 120) and for POST /api/projects/profile (default 10).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PROFILE_RATE_LIMIT_MAX=10
