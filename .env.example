# forgeCapita API — Environment Variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (Neon or any compatible provider); required, must start with postgres:// or postgresql://
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Port the Express server listens on (1-65535, default 3001)
PORT=3001

# Runtime mode: development | test | production (default development)
NODE_ENV=development

# Comma-separated exact browser origins allowed by CORS (scheme + host [+ port], no path,
# no trailing slash, no wildcard). Default http://localhost:3000 outside production;
# REQUIRED and non-empty in production, e.g. https://app.example.com
CORS_ORIGINS=http://localhost:3000

# Number of reverse-proxy hops to trust for client IP / rate limiting (0-5, default 0).
# Use 1 behind a single proxy such as Render. Never set to "true".
TRUST_PROXY=0

# Log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# Maximum JSON request body size, e.g. 100kb (default 100kb)
BODY_LIMIT=100kb

# Rate limiting (per IP, in-memory). Window in ms (default 60000); requests per window
# for all routes (default 120) and for POST /api/projects/profile (default 10).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
PROFILE_RATE_LIMIT_MAX=10

# Wallet sign-in. Sessions are opaque random tokens kept server-side (only their sha256 is
# stored), so there is NO session secret to configure.
# Comma-separated 0x wallets that are promoted to role "admin" on every login (default none).
# ADMIN_WALLETS=
# Domain shown in the sign-in message (host[:port]); default: host of the first CORS_ORIGINS entry.
# AUTH_DOMAIN=
# Session cookie SameSite: lax (default) or none (cross-site frontend; forces the Secure flag).
SESSION_COOKIE_SAMESITE=lax
# Requests per RATE_LIMIT_WINDOW_MS for POST /api/v1/auth/nonce and /verify combined (default 10).
AUTH_RATE_LIMIT_MAX=10

# Postgres schema where Ponder writes its tables (default ponder). Lowercase identifier:
# ^[a-z_][a-z0-9_]{0,62}$
PONDER_SCHEMA=ponder

# Optional connection string used only by `npm run migrate` / `migrate:status`; falls back
# to DATABASE_URL. Use the DIRECT (non-pooled) string from your provider when available.
# MIGRATION_DATABASE_URL=

# Interval (ms) of the launch-draft reconcile job that applies drafts once the project is indexed
# (default 15000, minimum 5000). Not started when NODE_ENV=test.
# DRAFT_RECONCILE_INTERVAL_MS=15000

# Gasless relayer (all optional; without RELAYER_ENABLED=true plus a key and an RPC URL per chain the
# relay routes answer 503 RELAY_DISABLED). The relayer address must be allow-listed in the registry.
# RELAYER_ENABLED=false
# RELAYER_PRIVATE_KEY=0xYOUR_64_HEX_RELAYER_KEY
# RELAYER_REGISTRY_ADDRESS=0x2e6A22fd249930b9F2905D1bD66443CbE366AacB
# RPC_URL_421614=https://YOUR_ARBITRUM_SEPOLIA_RPC
# RPC_URL_97=https://YOUR_BSC_TESTNET_RPC
# RELAYER_MAX_GAS_PRICE_GWEI_421614=1
# RELAYER_MAX_GAS_PRICE_GWEI_97=10
# RELAYER_MIN_BALANCE_WEI_421614=100000000000000
# RELAYER_MIN_BALANCE_WEI_97=1000000000000000
# RELAYER_USER_DAILY_LIMIT=20
# RELAYER_CHAIN_DAILY_LIMIT=500
# RELAYER_CONFIRMATIONS=2

# Automatic milestone execution: at the END of a voting period the API relayer calls executeMilestone()
# if nobody has (never earlier; early fast-track approval is executed by the developer). Needs a working relayer.
# Only the exact value "true" turns it on. Not started when NODE_ENV=test.
# MILESTONE_AUTOMATIC_EXECUTION=false
# MILESTONE_AUTOEXEC_INTERVAL_MS=60000
# MILESTONE_AUTOEXEC_MAX_ATTEMPTS=3

# Revenue audit (inflows): polls the Etherscan V2 explorer for native, internal and ERC-20 transfers
# INTO each approved founder shadow wallet. Starts only when REVENUE_AUDIT_ENABLED is exactly "true"
# AND ETHERSCAN_API_KEY is set; never started when NODE_ENV=test. The key is never logged.
# REVENUE_AUDIT_ENABLED=false
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_V2_API_KEY
# REVENUE_AUDIT_CHAINS=421614
# EXPLORER_POLL_INTERVAL_MS=900000
# Compliance reconciliation (same gating as above): flag a project when routed revenue trails the
# observed native inflow of the last 30 days by MORE than this many basis points (400 = 4%).
# REVENUE_TOLERANCE_BPS=400
# EXPLORER_MIN_INTERVAL_MS=600
# EXPLORER_BASE_URL=https://api.etherscan.io/v2/api

# Live minimum funding goal. MINIMUM_GOAL_MODE: "live" (default, also when empty) requires every launch
# draft to declare fundingGoalWei >= the gas-based minimum; "test" disables the check (use it on testnet
# for testing). Any other value fails startup so a typo cannot disable enforcement.
# MINIMUM_GOAL_MODE=live
# Floors are product numbers (wei): 0.5 ETH on Arbitrum Sepolia, 1 BNB on BSC Testnet. Ceilings are optional.
# MIN_GOAL_FLOOR_WEI_421614=500000000000000000
# MIN_GOAL_FLOOR_WEI_97=1000000000000000000
# MIN_GOAL_CEILING_WEI_421614=
# MIN_GOAL_CEILING_WEI_97=
# Estimated Arbitrum L1 fee per transaction (wei); BSC (97) uses 0.
# MIN_GOAL_L1_FEE_WEI_421614=60000000000000
# Formula inputs: deploy gas units, N investors, M milestones, safety margin in basis points.
# MIN_GOAL_GAS_UNITS=85020820
# MIN_GOAL_N=100
# MIN_GOAL_M=5
# MIN_GOAL_MARGIN_BPS=5000
# Gas sampling (needs RPC_URL_421614 / RPC_URL_97): average over GAS_WINDOW_HOURS (max 48), sampled every interval.
# GAS_WINDOW_HOURS=24
# GAS_SAMPLE_INTERVAL_MS=300000
